{
  "mcpServers": {
    "cpa-analytics-admin": {
      "command": "docker",
      "args": [
        "exec",
        "-i",
        "cpa_backend",
        "python3",
        "-m",
        "app.mcp.server",
        "--role",
        "admin"
      ]
    },
    "cpa-analytics-sales": {
      "command": "docker",
      "args": [
        "exec",
        "-i",
        "cpa_backend",
        "python3",
        "-m",
        "app.mcp.server",
        "--user",
        "azzuhri",
        "--pegawai",
        "CPA-452"
      ]
    },
    "cpa-analytics-warehouse": {
      "command": "docker",
      "args": [
