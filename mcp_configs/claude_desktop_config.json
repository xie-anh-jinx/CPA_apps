        "-m",
        "app.mcp.server",
        "--role",
        "warehouse_staff",
        "--pegawai",
        "CPA-051"
      ]
    },
    "cpa-analytics-finance": {
      "command": "docker",
      "args": [
        "exec",
        "-i",
        "cpa_backend",
        "python3",
        "-m",
        "app.mcp.server",
        "--role",
        "finance_manager"
      ]
    }
