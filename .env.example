# ─── Redis ───────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_cpa_2024
REDIS_URL=redis://:redis_cpa_2024@localhost:6379/0

# ─── JWT Auth ────────────────────────────────────────────────────
SECRET_KEY=GANTI_DENGAN_STRING_RANDOM_MINIMAL_32_KARAKTER
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Application ─────────────────────────────────────────────────
APP_NAME="CPA Inventory Intelligence & CRM"
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80

# ─── Sync Configuration ──────────────────────────────────────────
SYNC_INVENTORY_INTERVAL=15        # seconds
SYNC_SALES_INTERVAL=30            # seconds
SYNC_CUSTOMERS_INTERVAL=300       # seconds (5 menit)
SYNC_DISTRIBUTIONS_INTERVAL=60    # seconds
COMPUTE_ANALYTICS_INTERVAL=3600   # seconds (1 jam)
CHECK_ALERTS_INTERVAL=300         # seconds (5 menit)

# ─── Frontend ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_NAME="CPA Platform"

# ─── Flower (Celery Monitor) ─────────────────────────────────────
FLOWER_USER=admin
FLOWER_PASSWORD=flower2024

# ─── Alert Defaults ──────────────────────────────────────────────
ALERT_LOW_STOCK_ENABLED=true
ALERT_OVERSTOCK_ENABLED=true
ALERT_EXPIRY_DAYS_THRESHOLD=30
