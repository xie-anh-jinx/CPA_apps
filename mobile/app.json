{
  "expo": {
    "name": "CPA Analytics",
    "slug": "cpa-analytics-mobile",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "cpaanalytics",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0f19"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cpa.analytics.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Aplikasi membutuhkan akses kamera untuk scan barcode/QR dan bukti pengiriman.",
        "NSLocationWhenInUseUsageDescription": "Aplikasi membutuhkan lokasi untuk mencatat GPS pengiriman dan kunjungan sales.",
        "NSPhotoLibraryUsageDescription": "Aplikasi membutuhkan akses galeri foto untuk lampiran laporan dan profil."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0f19"
      },
      "package": "com.cpa.analytics.mobile",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Aplikasi membutuhkan izin kamera untuk scan barcode produk."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Aplikasi membutuhkan izin lokasi untuk validasi penerimaan barang."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
