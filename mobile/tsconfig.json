{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "jsx": "react-native",
    "lib": ["DOM", "ES2021"],
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./*"],
      "@shared/*": ["../shared/*"],
      "zod": ["./node_modules/zod"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../shared/**/*.ts"
  ]
}
